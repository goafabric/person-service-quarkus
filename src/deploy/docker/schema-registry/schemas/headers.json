{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Headers",
  "description": "Kafka record headers of the person and address topics, additional headers (e.g. tracing) are allowed",
  "type": "object",
  "properties": {
    "operation": { "type": "string", "enum": ["CREATE", "UPDATE", "DELETE"] },
    "X-TenantId": { "type": "string", "minLength": 1 },
    "X-OrganizationId": { "type": "string", "minLength": 1 },
    "X-Auth-Request-Preferred-Username": { "type": "string", "minLength": 1 }
  },
  "required": ["operation", "X-TenantId", "X-OrganizationId", "X-Auth-Request-Preferred-Username"]
}
