#!/bin/bash
cd "$(dirname "$0")"
source ../.values
export COMMAND=$1
export OPTION=$2

function func_compose {
    echo Going $1 ...
    docker-compose -p ${_Values_root_name}-schema-registry -f ./templates/docker-compose.yml $1 $2 $3 $4 $5
}

if [ "${COMMAND}" = "up" ]
then
    func_compose up -d
elif [ "${COMMAND}" = "down" ]
then
    func_compose down
elif [ "${COMMAND}" = "restart" ]
then
    func_compose down
    func_compose up -d
elif [ "${COMMAND}" = "pull" ]
then
    func_compose down
    func_compose pull
elif [ "${COMMAND}" = "prune" ]
then
    func_compose down --volumes
elif [ "${COMMAND}" = "update" ]
then
    func_compose down --volumes
    func_compose pull
    func_compose up -d
else
    echo Doing nothing !
fi
